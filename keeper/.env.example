# --- chain: which venue the desk runs on ---
CHAIN=solana                        # solana (Meteora + PumpSwap) | robinhood (pons v2 tax, Uniswap, USDG payouts)

# --- Robinhood Chain / pons v2 (only used when CHAIN=robinhood) ---
EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com
EVM_PRIVATE_KEY=                    # desk wallet private key (0x…), the creator fee recipient
EVM_TOKEN_ADDRESS=                  # your pons v2 token
EVM_TOKEN_DEPLOY_BLOCK=             # block the token launched in; speeds up the first holder index
EVM_OPS_WALLET=
EVM_GAS_RESERVE_ETH=0.002
EVM_MIN_PAYOUT_USDG=0.25
EVM_CLAIM_DUST_ETH=0.0005
EVM_SLIPPAGE_BPS=100
EVM_LOG_CHUNK=50000

# --- required ---
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY   # needs getProgramAccounts; the public RPC rate-limits pool loads
WALLET_SECRET=                      # base58 or JSON byte array of the desk wallet
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=               # service_role key (keeper only — never put this in the site)
DESK_NAME=desk                      # ledger id; the site reads the same name

# --- who gets paid ---
HOLDER_TOKEN_MINT=                  # YOUR token (pump.fun CA). Holders of this get the 50%
OPS_WALLET=                         # gets the 20%
HOLDER_SHARE_PCT=50
RESERVE_SHARE_PCT=30                # stays in the desk as capital for new pools
OPS_SHARE_PCT=20
BUYBACK_SHARE_PCT=0                 # % of the pot that buys back HOLDER_TOKEN_MINT and burns it (shares must sum to 100)
BUYBACK_DEXES=Pump.fun Amm,Pump.fun # PumpSwap after graduation, bonding curve before
PAYOUT_INTERVAL_HOURS=24
PAYOUT_THRESHOLD_SOL=0              # optional early trigger on the holder share (0 = clock only)
MIN_PAYOUT_SOL=0.002                # per-wallet dust floor; smaller amounts accrue
MIN_HOLD_TOKENS=0
EXCLUDE_WALLETS=                    # comma separated (team wallets, CEX hot wallets); PDAs are excluded automatically

# --- safety ---
DRY_RUN=true                        # flip to false to go live
DRY_RUN_SOL=10                      # paper-trade with a virtual bankroll (dry-run only; 0 = use real balances)
GAS_RESERVE_SOL=0.05                # always kept for transaction fees; never traded or paid out
GAS_MIN_SOL=0.004                   # below this only the fee claim runs (it costs ~0.00001 SOL)

# --- meme sleeve (share of the pool cap, own filters, exits and breaker) ---
MEME_SHARE_PCT=40
MEME_MAX_SEATS=0                    # 0 = no limit
MEME_MIN_SEATS=3                    # always spread the risky sleeve over at least this many coins
MEME_SEAT_SOL_MAX=8                 # and never more than this in one meme seat
MEME_MIN_MCAP_USD=500000
MEME_MIN_VOLUME_USD=500000
MEME_MIN_LIQ_USD=20000
MEME_MIN_HOLDERS=1500
MEME_MIN_ORGANIC=50
MEME_MAX_TOP_HOLDERS_PCT=35
MEME_TRAIL_PCT=10
MEME_MAX_HOLD_HOURS=6
MEME_FLOOR_PCT=12
MEME_BREAKER_PCT=20
MEME_BREAKER_PAUSE_HOURS=48

# --- which pools ---
SCAN_INTERVAL_SEC=300
POOL_ALLOC_PCT=70                   # % of the treasury (minus what's owed) the pool desk may deploy
POOL_MAX_CAPITAL_SOL=0              # optional hard ceiling in SOL (0 = none, just the %)
SEAT_SOL=4                          # one more seat per 4 SOL of sleeve capital...
SEAT_SOL_MAX=25                     # ...and no seat bigger than this, so growth adds seats, not size                          # one seat per 4 SOL of capital: 10 SOL → 2 seats, 30 → 7, 50+ → 8
MIN_SEATS=2
MAX_SEATS=0                         # 0 = no limit on open seats
SEAT_WEIGHTS=30,22,16,12,8,6,3,3    # capital share by rank (best pool first), renormalised to open seats
MAX_SEAT_PCT=30                     # no single seat above this % of capital
MIN_CAPITAL_PER_POOL_SOL=1.5        # don't open a seat smaller than this
MIN_TVL_USD=50000
MIN_VOLUME_24H_USD=500000
MIN_POOL_AGE_HOURS=6
MIN_FEE_TVL_1H_PCT=0                # calm-pool mode ranks on 24h fees ÷ volatility instead
MAX_RANGE_24H=1.05                  # only pools whose price moved less than 5% in the last 24h
REQUIRE_FREEZE_DISABLED=true
POOL_ALLOWLIST=                     # pin specific pools (e.g. your own); still filtered + ranked
POOL_DENYLIST=
TOKEN_DENYLIST=

# --- when a pool gets closed ---
ROTATE_OUT_SCANS=72                 # scans in a row outside the top 2×MAX_POOLS before exiting
MAX_HOLD_HOURS=0                    # 0 = no time limit
EXIT_SELL_INVENTORY=true            # sell the pool's token back to SOL on exit
FLOOR_PCT_BELOW_ENTRY=12            # 35 → close + sell if price falls 35% below the pool's entry (0 = off)

# --- band ---
BINS_BELOW=34
BINS_ABOVE=34
STRATEGY=Spot                       # Spot | Curve | BidAsk
ENTRY_MODE=balanced                 # balanced = buy X first then LP both sides; bid = SOL-only bids below price
BALANCED_X_PCT=50
REBALANCE_MODE=inventory            # inventory = re-LP what we hold; balanced = swap back to the split first
OUT_OF_RANGE_TICKS=2
REBALANCE_COOLDOWN_SEC=60
ADD_LIQ_SLIPPAGE_PCT=2
SWAP_SLIPPAGE_BPS=300

# --- harvest ---
HARVEST_INTERVAL_SEC=300
HARVEST_MIN_SOL=0.01
SELL_FEE_X=true
MIN_SELL_X_SOL=0.005

# --- income: your share of the pump.fun creator fee (fee sharing: 85% → this wallet, 15% → OPS directly) ---
INCOME_WALLET_SECRET=               # the wallet you set as the 85% fee-sharing recipient; swept into the pot
INCOME_SWEEP_SEC=600
INCOME_MIN_SWEEP_SOL=0.05

# --- stock desk: xStocks vs the real stock price ---
STOCK_MODE=paper                    # off | paper (logs only, no capital) | live (trades a book funded from fee income)
STOCK_CAPITAL_SOL=10                # most the book grows to; funded in steps from free SOL, never upfront
STOCK_TOPUP_MIN_SOL=0.3
STOCK_MIN_CLIP_USD=15
STOCK_TICK_SEC=30
STOCK_CLIP_USD=500
STOCK_ENTER_PCT=0.4
STOCK_TICKERS=NVDA,TSLA,SPY,AAPL,MSTR,QQQ,META,COIN
STOCK_REF_SOURCE=finnhub            # finnhub (free key at finnhub.io) · pyth · yahoo (fallback)
FINNHUB_KEY=
PYTH_API_KEY=

# --- creator-fee auto-claim: pump.fun fee sharing, distributed by the keeper (permissionless) ---
# Set fee sharing on pump.fun to: 85% → the DESK wallet, 15% → OPS. The desk's share is booked into the pot.
CLAIM_ENABLED=true
CLAIM_CHECK_SEC=60
CLAIM_MIN_USD=100                   # distribute as soon as $100 is waiting...
CLAIM_INTERVAL_SEC=300              # ...or every 5 minutes, whichever comes first
CLAIM_DUST_SOL=0.005

# --- loop ---
TICK_MS=15000
SNAPSHOT_INTERVAL_SEC=900             # equity history row for the site chart
PRIORITY_FEE_MICROLAMPORTS=50000
PORT=8080
